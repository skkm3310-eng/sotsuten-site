---
import Base from "../../layouts/Base.astro";
import { getBlogList, formatDate } from "../../lib/microcms";

export async function getStaticPaths() {
  const posts = await getBlogList();
  return posts.map((item) => ({ params: { id: item.id }, props: { item } }));
}

const { item } = Astro.props;
---

<Base title={item.title}>
  <article class="section">
    <div class="container">
      <p class="meta">
        <time datetime={item.publishedAt}>{formatDate(item.publishedAt)}</time>
        <span class="tag">{item.category[0]}</span>
      </p>
      <h1>{item.title}</h1>
      {item.thumbnail && (
        <figure><img src={item.thumbnail.url} alt="" width={item.thumbnail.width} height={item.thumbnail.height} /></figure>
      )}
      <div class="prose" set:html={item.body} />
      <p class="back"><a href="/blog/">← Blog一覧へ</a></p>
    </div>
  </article>
</Base>

<style>
  .meta { display: flex; align-items: center; gap: var(--space-1); color: var(--color-ink-weak); font-size: var(--text-sm); }
  h1 { font-size: var(--text-xl); line-height: 1.3; margin-block: var(--space-2) var(--space-4); }
  figure { border-radius: var(--radius-lg); overflow: hidden; margin-bottom: var(--space-4); }
  .back { margin-top: var(--space-5); }
</style>
