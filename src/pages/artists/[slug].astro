---
import Base from "../../layouts/Base.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const artists = await getCollection("artists");
  return artists.map((artist) => ({ params: { slug: artist.id }, props: { artist } }));
}

const { artist } = Astro.props;
const { name, category, exhibition, portfolio } = artist.data;
const { Content } = await render(artist);
---

<Base title={name} description={`${name}の出展作品・これまでの作品`}>
  <article class="section">
    <div class="container">
      <p class="tags">{category.map((c) => <span class="tag">{c}</span>)}</p>
      <h1>{name}</h1>
      <div class="prose statement"><Content /></div>

      <!-- 今回の出展作品(まだ無ければ「準備中」表示) -->
      <section class="block">
        <h2 class="block-title">今回の出展作品</h2>
        {exhibition.length === 0 ? (
          <p class="coming">出展作品は現在準備中です。会期に向けて公開します。</p>
        ) : (
          <div class="works">
            {exhibition.map((w) => (
              <figure class="work">
                <img src={w.image} alt={w.title} loading="lazy" />
                <figcaption>
                  <span class="wtitle">{w.title}</span>
                  {w.caption && <span class="wcap">{w.caption}</span>}
                </figcaption>
              </figure>
            ))}
          </div>
        )}
      </section>

      <!-- これまでの作品(ポートフォリオ) -->
      {portfolio.length > 0 && (
        <section class="block portfolio">
          <h2 class="block-title">Portfolio<small>これまでの作品</small></h2>
          <div class="works">
            {portfolio.map((w) => (
              <figure class="work">
                <img src={w.image} alt={w.title} loading="lazy" />
                <figcaption>
                  <span class="wtitle">{w.title}</span>
                  {w.caption && <span class="wcap">{w.caption}</span>}
                </figcaption>
              </figure>
            ))}
          </div>
        </section>
      )}

      <p class="back"><a href="/works/">← 出展者一覧へ</a></p>
    </div>
  </article>
</Base>

<style>
  .tags { display: flex; gap: var(--space-1); flex-wrap: wrap; }
  h1 { font-size: var(--text-xl); line-height: 1.3; margin-block: var(--space-1) var(--space-3); }
  .statement { margin-bottom: var(--space-5); }

  .block { margin-bottom: var(--space-6); }
  .block-title {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 400;
    font-size: var(--text-lg);
    padding-bottom: var(--space-1);
    border-bottom: 2px solid var(--color-ink);
    margin-bottom: var(--space-4);
  }
  .block-title small {
    font-family: var(--font-body);
    font-style: normal;
    font-size: var(--text-xs);
    color: var(--color-ink-weak);
    margin-left: var(--space-1);
  }
  /* ポートフォリオ側は少しだけ控えめに(出展作品を主役に見せる) */
  .portfolio .block-title { border-bottom-color: var(--color-line); }

  .coming {
    color: var(--color-ink-weak);
    background: color-mix(in srgb, var(--color-ink) 4%, transparent);
    border-radius: var(--radius-md);
    padding: var(--space-4);
    text-align: center;
  }

  .works { display: grid; gap: var(--space-4); }
  .work img { width: 100%; border-radius: var(--radius-md); background: var(--color-surface); }
  figcaption { display: flex; flex-direction: column; margin-top: var(--space-1); }
  .wtitle { font-weight: 700; }
  .wcap { font-size: var(--text-sm); color: var(--color-ink-weak); }
  .back { margin-top: var(--space-4); }
</style>
