---
/**
 * HERO キービジュアル(カメレオン)
 * - イラスト(/public/chameleon.svg)を配置
 * - イラスト内の目の位置に、瞳孔だけを重ねて表示
 * - 初回表示: 決まった動き(3.6秒) → PC: カーソル追従 / スマホ: idleの上下左右揺れ
 * - テキスト部分はFigma(node 1:55)の数値をそのまま反映
 */
---

<section class="hero" aria-label="キービジュアル">
  <div class="chameleon-wrapper">
    <img src="/chameleon.svg" alt="カメレオンのイラスト" class="chameleon-img" />
    <div class="eye-area" id="eyeArea">
      <div class="pupil" id="pupil"></div>
    </div>
  </div>

  <div class="hero-text">
    <div class="top-row">
      <p class="eyebrow">Group Exhibition</p>
      <p class="location">in HARAJUKU Tokyo</p>
    </div>

    <h1 class="title">変化</h1>

    <div class="bottom-row">
      <p class="tagline">
        Design, Graphic, Illustration —<br />
        7 artists exploring the theme of change.
      </p>
      <div class="meta">
        <div class="meta-item">
          <p class="meta-value">2027.03.20 (Sat)</p>
          <p class="meta-label">day_</p>
        </div>
        <div class="meta-item">
          <p class="meta-value">¥ Free</p>
          <p class="meta-label">Entry_</p>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const pupil = document.getElementById("pupil");
  const eyeArea = document.getElementById("eyeArea");

  if (pupil && eyeArea) {
    pupil.classList.add("opening");

    pupil.addEventListener("animationend", function handler() {
      pupil.removeEventListener("animationend", handler);
      pupil.classList.remove("opening");

      const isTouchDevice = window.matchMedia("(pointer: coarse)").matches;
      if (isTouchDevice) {
        enableIdle();
      } else {
        enableCursorFollow();
      }
    });
  }

  function enableIdle() {
    pupil?.classList.add("idle-sway");
  }

  function enableCursorFollow() {
    window.addEventListener("mousemove", (e) => {
      if (!eyeArea || !pupil) return;
      const rect = eyeArea.getBoundingClientRect();
      const cx = rect.left + rect.width / 2;
      const cy = rect.top + rect.height / 2;
      const dx = e.clientX - cx;
      const dy = e.clientY - cy;
      const maxDistance = rect.width * 0.22;
      const angle = Math.atan2(dy, dx);
      const distance = Math.min(Math.hypot(dx, dy), maxDistance);
      const x = Math.cos(angle) * distance;
      const y = Math.sin(angle) * distance;
      pupil.style.transform = `translate(calc(-50% + ${x}px), calc(-50% + ${y}px))`;
    });
  }
</script>

<style>
  .hero { padding: var(--space-3); }

  .chameleon-wrapper {
    position: relative;
    width: 100%;
    max-width: 1120px;
    aspect-ratio: 1120 / 794;
    margin-inline: auto;
  }

  .chameleon-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  .eye-area {
    position: absolute;
    top: 22.10%;
    left: 73.53%;
    width: 5.4464%;
    aspect-ratio: 1 / 1;
    transform: translate(-50%, -50%);
  }

  .pupil {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 22%;
    aspect-ratio: 1 / 1;
    border-radius: 50%;
    background: #666666;
    transform: translate(-50%, -50%);
  }

  .pupil.opening {
    animation-name: pupilOpening;
    animation-duration: 3.6s;
    animation-fill-mode: forwards;
  }
  @keyframes pupilOpening {
    0%   { transform: translate(-50%, -50%); animation-timing-function: linear; }
    22%  { transform: translate(-50%, -50%); animation-timing-function: linear; }
    37%  { transform: translate(calc(-50% + 138.46%), calc(-50% - 7.69%)); animation-timing-function: linear; }
    41%  { transform: translate(calc(-50% + 138.46%), calc(-50% - 7.69%)); animation-timing-function: linear; }
    66%  { transform: translate(calc(-50% - 92.31%), calc(-50% - 76.92%)); animation-timing-function: linear; }
    70%  { transform: translate(calc(-50% - 92.31%), calc(-50% - 76.92%)); animation-timing-function: linear; }
    89%  { transform: translate(calc(-50% - 69.23%), calc(-50% + 100%)); animation-timing-function: cubic-bezier(0.33, 1, 0.68, 1); }
    100% { transform: translate(-50%, -50%); }
  }

  .pupil.idle-sway { animation: pupilSway 6s ease-in-out infinite; }
  @keyframes pupilSway {
    0%   { transform: translate(calc(-50% - 61.54%), calc(-50% + 0%)); }
    25%  { transform: translate(calc(-50% + 0%), calc(-50% - 61.54%)); }
    50%  { transform: translate(calc(-50% + 61.54%), calc(-50% + 0%)); }
    75%  { transform: translate(calc(-50% + 0%), calc(-50% + 61.54%)); }
    100% { transform: translate(calc(-50% - 61.54%), calc(-50% + 0%)); }
  }

  .hero-text {
    max-width: 1624px;
    margin-inline: auto;
    padding-inline: var(--space-4);
    margin-top: var(--space-4);
  }

  .top-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .eyebrow, .location {
    font-family: var(--font-body);
    font-weight: 400;
    font-size: 24px;
    line-height: 13.2px;
    text-transform: uppercase;
    color: var(--color-ink-weak);
    white-space: nowrap;
  }
  .eyebrow { letter-spacing: 3.96px; }
  .location { letter-spacing: 3.08px; text-align: right; }

  .title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 252px;
    line-height: 1;
    letter-spacing: 12.6px;
    color: var(--color-ink);
    margin: 0;
  }

  .bottom-row {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-3);
    padding-top: 20px;
  }

  .tagline {
    font-family: var(--font-body);
    font-weight: 300;
    font-size: 20px;
    line-height: 35.84px;
    letter-spacing: 0.224px;
    color: var(--color-ink-weak);
    max-width: 512px;
  }

  .meta { display: flex; gap: 48px; }
  .meta-item { display: flex; flex-direction: column; align-items: center; }
  .meta-value {
    font-family: var(--font-body);
    font-weight: 300;
    font-size: 44.8px;
    line-height: 67.2px;
    letter-spacing: -0.896px;
    color: var(--color-ink);
    text-align: center;
    white-space: nowrap;
  }
  .meta-label {
    font-family: var(--font-body);
    font-weight: 400;
    font-size: 8.8px;
    line-height: 13.2px;
    letter-spacing: 2.64px;
    text-transform: uppercase;
    color: var(--color-ink-weak);
  }
</style>
