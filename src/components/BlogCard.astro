---
import { formatDate, type Blog } from "../lib/microcms";

interface Props {
  item: Blog;
}
const { item } = Astro.props;
---

<a href={`/blog/${item.id}/`} class="card">
  <figure>
    {item.thumbnail ? (
      <img src={item.thumbnail.url} alt="" loading="lazy" width={item.thumbnail.width} height={item.thumbnail.height} />
    ) : (
      <div class="placeholder" aria-hidden="true">Blog</div>
    )}
  </figure>
  <div>
    <p class="title">{item.title}</p>
    <p class="meta">
      <time datetime={item.publishedAt}>{formatDate(item.publishedAt)}</time>
      <span class="tag">{item.category[0]}</span>
    </p>
  </div>
</a>

<style>
  .card { display: block; text-decoration: none; }
  figure {
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--color-surface);
    margin-bottom: var(--space-2);
    aspect-ratio: 16 / 9;
  }
  figure img { width: 100%; height: 100%; object-fit: cover; }
  .placeholder {
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--text-lg);
    color: var(--color-ink-weak);
  }
  .title { font-weight: 700; }
  .card:hover .title { color: var(--color-accent); }
  .meta { display: flex; align-items: center; gap: var(--space-1); margin-top: var(--space-1); font-size: var(--text-sm); color: var(--color-ink-weak); }
</style>
