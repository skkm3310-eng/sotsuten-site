---
import { formatDate, type News } from "../lib/microcms";

interface Props {
  items: News[];
}
const { items } = Astro.props;
---

<div class="accordion">
  {items.map((item) => (
    <a class="row" href={`/news/${item.id}/`}>
      <time datetime={item.publishedAt}>{formatDate(item.publishedAt)}</time>
      <span class="tag">{item.category[0]}</span>
      <span class="title">{item.title}</span>
      <span class="arrow" aria-hidden="true">→</span>
    </a>
  ))}
</div>

<style>
  .row {
    border-bottom: 1px solid var(--color-line);
    text-decoration: none;
    color: inherit;
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding-block: var(--space-2);
  }
  .row:hover .title { text-decoration: underline; text-underline-offset: 3px; }
  time { font-size: var(--text-sm); color: var(--color-ink-weak); flex-shrink: 0; }
  .tag { flex-shrink: 0; }
  .title { font-weight: 500; }
  .arrow { margin-left: auto; color: var(--color-ink-weak); }
  @media (max-width: 600px) {
    .row { flex-wrap: wrap; }
    .title { width: 100%; }
  }
</style>
