---
// 上部ヘッダー(サイドバー廃止版)。Figma準拠: 左にサイト名、右にナビ。
const nav = [
  { href: "/works/", label: "Works" },
  { href: "/artists/", label: "Artists" },
  { href: "/news/", label: "News" },
];
const current = Astro.url.pathname;
const isActive = (href: string) => current === href || (href !== "/" && current.startsWith(href));
---

<header class="site-header">
  <div class="inner">
    <a href="/" class="brand">変化 <span>Exhibition</span></a>

    <button class="toggle" aria-expanded="false" aria-controls="site-nav" aria-label="メニュー">
      <span></span><span></span>
    </button>

    <nav id="site-nav" aria-label="メイン">
      {nav.map((item) => (
        <a href={item.href} class:list={["link", { on: isActive(item.href) }]}>{item.label}</a>
      ))}
    </nav>
  </div>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>(".site-header .toggle");
  const nav = document.getElementById("site-nav");
  btn?.addEventListener("click", () => {
    const open = btn.getAttribute("aria-expanded") === "true";
    btn.setAttribute("aria-expanded", String(!open));
    nav?.classList.toggle("open", !open);
  });
</script>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 20;
    background: color-mix(in srgb, var(--color-panel) 88%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--color-line);
  }
  .inner {
    max-width: var(--container-max); margin-inline: auto;
    display: flex; align-items: center; justify-content: space-between;
    padding-block: var(--space-2);
    padding-inline: var(--space-4);
    box-sizing: border-box;
  }
  .brand {
    font-size: 0.6rem; letter-spacing: 0.3em; text-transform: uppercase;
    text-decoration: none; color: #0d0d0d;
  }
  .brand span { color: var(--color-ink-weak); }
  nav { display: flex; gap: var(--space-3); }
  .link {
    font-size: 0.6rem; letter-spacing: 0.25em; text-transform: uppercase;
    text-decoration: none; color: var(--color-ink-weak);
    padding-bottom: 2px; border-bottom: 1px solid transparent;
  }
  .link:hover { color: #0d0d0d; }
  .link.on { color: #0d0d0d; border-bottom-color: #0d0d0d; }

  .toggle { display: none; }
  @media (max-width: 640px) {
    .toggle {
      display: inline-flex; flex-direction: column; gap: 5px;
      background: none; border: 0; padding: 8px; order: 3;
    }
    .toggle span { width: 22px; height: 1.5px; background: #0d0d0d; }
    nav {
      position: absolute; left: 0; right: 0; top: 100%;
      flex-direction: column; gap: 0;
      background: var(--color-panel); border-bottom: 1px solid var(--color-line);
      padding-block: var(--space-2); display: none;
    }
    nav.open { display: flex; }
    .link { padding-block: var(--space-1); }
  }
</style>
