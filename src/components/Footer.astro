---
const year = new Date().getFullYear();
const links = [
  { href: "https://twitter.com/", label: "X" },
  { href: "https://instagram.com/", label: "Instagram" },
];
---

<footer class="site-footer">
  <div class="container inner">
    <a class="mail" href="mailto:example@example.com">example@example.com</a>
    <nav class="links" aria-label="SNS">
      {links.map((l) => <a href={l.href} target="_blank" rel="noopener">{l.label}</a>)}
    </nav>
    <small>© {year} 変化 Exhibition</small>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-line);
    background: var(--color-panel);
  }
  .inner {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
    padding-block: var(--space-4);
    font-size: var(--text-sm);
  }
  .mail { text-decoration: none; color: var(--color-ink); }
  .mail:hover { text-decoration: underline; text-underline-offset: 3px; }
  .links { display: flex; gap: var(--space-3); }
  .links a { text-decoration: none; color: var(--color-ink-weak); }
  .links a:hover { color: var(--color-ink); }
  small {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-ink-weak);
  }
  @media (max-width: 600px) {
    small { margin-left: 0; width: 100%; }
  }
</style>
